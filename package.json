{
  "name": "@nijaru/pi-provider-compaction",
  "version": "0.0.3",
  "type": "module",
  "description": "Provider-native context compaction adapters for Pi",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "compaction",
    "openai",
    "responses"
  ],
  "license": "MIT",

  "publishConfig": {
    "access": "public"
  },
  "author": "Nick Naru <nick@nijaru.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/nijaru/pi-provider-compaction.git"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "bun run build.ts",
    "prepack": "bun run build",
    "test": "bun test",
    "lint": "oxlint build.ts index.ts protocol.ts policy.ts tests/",
    "typecheck": "tsc --noEmit",
    "check": "bun test && oxlint build.ts index.ts protocol.ts policy.ts tests/ && tsc --noEmit"
  },
  "files": [
    "dist",
    "index.ts",
    "protocol.ts",
    "policy.ts",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/bun": "latest",
    "oxlint": "^1.81.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.1"
  }
}
